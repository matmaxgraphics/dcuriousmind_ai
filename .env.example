# ── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Supabase ─────────────────────────────────────────────────────────────────
# The service role key bypasses RLS. Server-side only — never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Pipeline endpoint ────────────────────────────────────────────────────────
# Required. Guards POST /api/pipeline/run and the developer-only routes.
# Without it those endpoints refuse to run (503) rather than running openly.
# Generate one with:  openssl rand -hex 32
#
# On Vercel, setting CRON_SECRET instead makes Vercel Cron authenticate itself
# automatically — it sends `Authorization: Bearer $CRON_SECRET`. Either name
# works; PIPELINE_SECRET takes precedence.
PIPELINE_SECRET=

# ── Dashboard login ──────────────────────────────────────────────────────────
# Shared admin password for the editorial dashboard, and the key used to sign
# the session cookie. Both required — without them the dashboard and every
# editorial API route return 503 rather than opening up.
# Generate a session secret with:  openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Cost control ─────────────────────────────────────────────────────────────
# Max articles put through paid AI scoring in a single pipeline run. The rest
# stay queued for the next run. Defaults to 25 if unset.
MAX_ARTICLES_PER_SCORING_RUN=25
