# ── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Supabase ─────────────────────────────────────────────────────────────────
# The service role key bypasses RLS. Server-side only — never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Pipeline endpoint ────────────────────────────────────────────────────────
# Required. Guards POST /api/pipeline/run and the developer-only routes.
# Without it those endpoints refuse to run (503) rather than running openly.
# Generate one with:  openssl rand -hex 32
#
# On Vercel, setting CRON_SECRET makes Vercel Cron authenticate itself
# automatically — it sends `Authorization: Bearer $CRON_SECRET`.
#
# EITHER secret is accepted, independently. You can set both to different
# values safely: CRON_SECRET for the scheduler, PIPELINE_SECRET for your own
# scripted runs.
PIPELINE_SECRET=

# ── Dashboard login ──────────────────────────────────────────────────────────
# Shared admin password for the editorial dashboard, and the key used to sign
# the session cookie. Both required — without them the dashboard and every
# editorial API route return 503 rather than opening up.
# Generate a session secret with:  openssl rand -hex 32
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Cost control ─────────────────────────────────────────────────────────────
# Max articles put through paid AI scoring in a single pipeline run. The rest
# stay queued for the next run. Defaults to 25 if unset.
MAX_ARTICLES_PER_SCORING_RUN=5

# ── X publishing (OAuth 1.0a user context) ───────────────────────────────────
# From developer.x.com -> your app -> Keys and tokens -> OAuth 1.0 Keys.
# The access token must show "Read and Write"; if it says Read-only, set the
# app permissions first and then regenerate it.
# Publishing is refused (503) when these are unset.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Question generation ──────────────────────────────────────────────────────
# Questions proposed per discovery run. Each is grounded in a Wikipedia
# article before entering the pipeline; ungrounded ones are dropped.
# Defaults to 8 if unset.
QUESTIONS_PER_GENERATION_RUN=3

# Max drafts generated per run. Each costs ~3 AI calls (rewrite + fact check
# + quality check) carrying source text, so this is the heaviest stage.
# Groq's free tier allows 100,000 tokens per DAY. Defaults to 4.
MAX_DRAFTS_PER_RUN=1

# Max articles extracted per run. No AI cost, but each is a fetch + parse and
# the route has a 300s budget. Defaults to 10.
MAX_EXTRACTIONS_PER_RUN=3

# Wall-clock budget for one pipeline run, in ms. Stages stop starting new work
# once this is spent, leaving the rest queued for the next run. Must stay
# BELOW the route's maxDuration (120s) — a serverless function killed at the
# limit cannot release the run lock. Defaults to 95000.
PIPELINE_BUDGET_MS=50000
